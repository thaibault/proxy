{
  "name": "certbot-proxy",
  "version": "4.0.0",
  "description": "generic dockerized nginx proxy server with certbot",
  "keywords": [
    "archLinux",
    "arch",
    "certbot",
    "docker",
    "hosting",
    "linux",
    "proxy"
  ],
  "homepage": "https://tsickert.com/certbot-proxy",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/certbot-proxy.git"
  },
  "main": "Dockerfile",
  "files": [
    "Dockerfile",
    "etc",
    "scripts",
    "service"
  ],
  "scripts": {
    "lint": "shellcheck -x scripts/*.sh test/*.sh",
    "lint:given": "shellcheck -x",
    "start": "docker compose --file service/docker/base.yaml --file service/docker/mounts.yaml --file service/docker/local.yaml up",
    "test": "bash ./test/scripts.sh",
    "update:documentation": "web-documentation"
  },
  "devDependencies": {
    "shellcheck": "^4.1.0",
    "web-documentation": "^1.0.77"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "tagline": "proxy your docker container"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
